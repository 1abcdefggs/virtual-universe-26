{
  "name": "Section 1: The Modern GitHub Experience",
  // The default Codespaces image is cached on every host, so it starts without a build.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  // Runs after the editor opens, so it never delays the README.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["01-github-latest-features/README.md"]
    },
    "vscode": {
      "extensions": ["GitHub.github-vscode-theme"],
      "settings": {
        "workbench.colorTheme": "GitHub Light Default",
        "workbench.startupEditor": "none",
        "workbench.tips.enabled": false,
        "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor" },
        "markdown.preview.openMarkdownLinks": "inPreview",
        "markdown.styles": [".devcontainer/preview.css"],
        "extensions.ignoreRecommendations": true
      }
    }
  }
}
